# Binaries and build output
/bin/
*.exe
*.test
*.out
# `go build ./cmd/<x>` drops a bare binary at the repo root: ignore those
/ingest
/worker
/server
/migrate
/banhmi
/mcp

# Go
/vendor/
coverage.*
*.coverprofile

# Local config and secrets: never commit
/config/config.yaml
/config/*.local.yaml
/config/vault-data.json
/config/vault-keys.json
.env
*.env
.env.*
.env*
*.env.*
*service-account*.json
id_rsa*
id_ed25519*
id_ecdsa*
*.p12
*.pfx
*credentials*
/deploy/dev/certs/
*.pem
*.key
*-sa.json

# Build cache (pre-populated from S3; local builds leave empty)
/cache/**
!/cache/**/.gitkeep

# Local-only operator scripts (never committed)
/local/

# Crawled data, OCR images, local samples and benchmark artifacts
/data/
/tmp/
*.pdf
*.doc
*.docx
/test/samples/

# OCR sidecar (Python)
__pycache__/
*.pyc

# Tool-local agent state
!/.claude/
/.claude/*
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/designer.md
!/.codex/
/.codex/*
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/implementer.toml
!/.codex/agents/design-reviewer.toml
!/.codex/agents/code-reviewer.toml
/.worktrees/
/.playwright-mcp/
/.mcp.json
/.idea/
/.vscode/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

.air.toml

# Shared contributor instructions belong in this repository.
!/AGENTS.md
!/CLAUDE.md
!/instructions/
!/instructions/*.md
