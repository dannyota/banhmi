# Binaries and build output
/bin/
*.exe
*.test
*.out
# `go build ./cmd/<x>` drops a bare binary at the repo root: ignore those
/ingest
/worker
/server
/migrate
/banhmi
/mcp

# Go
/vendor/
coverage.*
*.coverprofile

# Build cache (pre-populated from S3; local builds leave empty)
/cache/**
!/cache/**/.gitkeep

# Local-only operator scripts (never committed)
/local/

# Crawled data, OCR images, local samples and benchmark artifacts
/data/
/tmp/
*.pdf
*.doc
*.docx
/test/samples/

# OCR sidecar (Python)
__pycache__/
*.pyc

# Tool-local agent state
# Track agent definitions only: Markdown under .claude/agents, TOML under .codex/agents.
!/.claude/
/.claude/*
!/.claude/agents/
/.claude/agents/**
!/.claude/agents/**/
!/.claude/agents/**/*.md
/.claude/agents/**/agent-memory*/
/.claude/agents/**/worktrees/
!/.codex/
/.codex/*
!/.codex/agents/
/.codex/agents/**
!/.codex/agents/**/
!/.codex/agents/**/*.toml
/.codex/agents/**/config.toml
/.codex/agents/**/agent-memory*/
/.codex/agents/**/worktrees/
/.worktrees/
/.playwright-mcp/
/.mcp.json
/.idea/
/.vscode/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

.air.toml

# Shared contributor instructions belong in this repository.
!/AGENTS.md
!/CLAUDE.md
!/instructions/
!/instructions/*.md

# Local config and secrets: never commit. Keep this block last so no earlier
# negation, such as the agent definition allowlist, can re-include a secret.
/config/config.yaml
/config/*.local.yaml
/config/vault-data.json
/config/vault-keys.json
.env
*.env
.env.*
.env*
*.env.*
*service-account*.json
id_rsa*
id_ed25519*
id_ecdsa*
*.p12
*.pfx
*credentials*
/deploy/dev/certs/
*.pem
*.key
*-sa.json
