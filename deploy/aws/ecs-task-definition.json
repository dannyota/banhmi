{
  "family": "banhmi-mcp",
  "networkMode": "host",
  "requiresCompatibilities": [
    "EC2"
  ],
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "banhmi-mcp",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/banhmi-mcp:latest",
      "essential": true,
      "readonlyRootFilesystem": true,
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8081"
        },
        {
          "name": "BANHMI_JURISDICTIONS",
          "value": "vn,my,id,sg,th,kh"
        },
        {
          "name": "BANHMI_TRUST_PROXY",
          "value": "true"
        },
        {
          "name": "BANHMI_EMBED_ENDPOINT",
          "value": "http://127.0.0.1:8089"
        },
        {
          "name": "BANHMI_DATABASE_HOST",
          "value": "YOUR_RDS_ENDPOINT"
        },
        {
          "name": "BANHMI_DATABASE_PORT",
          "value": "5432"
        },
        {
          "name": "BANHMI_DATABASE_USER",
          "value": "banhmi"
        },
        {
          "name": "BANHMI_DATABASE_SSLMODE",
          "value": "require"
        }
      ],
      "secrets": [
        {
          "name": "BANHMI_DATABASE_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:YOUR_ACCOUNT_ID:parameter/banhmi/db-password"
        },
        {
          "name": "BANHMI_ORIGIN_VERIFY_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:YOUR_ACCOUNT_ID:secret:banhmi-origin-verify-SUFFIX"
        },
        {
          "name": "BANHMI_EMBED_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:YOUR_ACCOUNT_ID:parameter/banhmi/embed-token"
        }
      ],
      "memory": 600,
      "memoryReservation": 300,
      "cpu": 256,
      "healthCheck": {
        "command": [
          "CMD",
          "/healthcheck",
          "http://localhost:8081/healthz"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 240
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/banhmi-mcp",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "banhmi"
        }
      }
    }
  ]
}
