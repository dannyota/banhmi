{
  "family": "banhmi-mcp",
  "networkMode": "host",
  "requiresCompatibilities": [
    "EC2"
  ],
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "banhmi-mcp",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/banhmi-mcp:latest",
      "essential": true,
      "readonlyRootFilesystem": true,
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8081"
        },
        {
          "name": "BANHMI_JURISDICTION",
          "value": "vn"
        },
        {
          "name": "BANHMI_TRUST_PROXY",
          "value": "true"
        },
        {
          "name": "BANHMI_EMBED_QUERY",
          "value": "onnx"
        },
        {
          "name": "BANHMI_ONNX_MODEL",
          "value": "/models/qwen3-embedding/model_fp16.onnx"
        },
        {
          "name": "BANHMI_ONNX_TOKENIZER",
          "value": "/models/qwen3-embedding/tokenizer.json"
        },
        {
          "name": "BANHMI_ONNX_LIB",
          "value": "/usr/lib/libonnxruntime.so"
        }
      ],
      "secrets": [
        {
          "name": "BANHMI_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:YOUR_ACCOUNT_ID:secret:banhmi-db-url-vn"
        },
        {
          "name": "BANHMI_ORIGIN_VERIFY_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:YOUR_ACCOUNT_ID:secret:banhmi-origin-verify"
        }
      ],
      "memory": 1100,
      "memoryReservation": 900,
      "cpu": 256,
      "healthCheck": {
        "command": [
          "CMD",
          "/healthcheck",
          "http://localhost:8081/healthz"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/banhmi-mcp",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "banhmi"
        }
      }
    },
    {
      "name": "laksa-mcp",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com/banhmi-mcp:latest",
      "essential": true,
      "readonlyRootFilesystem": true,
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "portMappings": [
        {
          "containerPort": 8082,
          "hostPort": 8082,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8082"
        },
        {
          "name": "BANHMI_JURISDICTION",
          "value": "my"
        },
        {
          "name": "BANHMI_TRUST_PROXY",
          "value": "true"
        },
        {
          "name": "BANHMI_EMBED_QUERY",
          "value": "onnx"
        },
        {
          "name": "BANHMI_ONNX_MODEL",
          "value": "/models/qwen3-embedding/model_fp16.onnx"
        },
        {
          "name": "BANHMI_ONNX_TOKENIZER",
          "value": "/models/qwen3-embedding/tokenizer.json"
        },
        {
          "name": "BANHMI_ONNX_LIB",
          "value": "/usr/lib/libonnxruntime.so"
        }
      ],
      "secrets": [
        {
          "name": "BANHMI_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:YOUR_ACCOUNT_ID:secret:banhmi-db-url-my"
        },
        {
          "name": "BANHMI_ORIGIN_VERIFY_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:YOUR_ACCOUNT_ID:secret:banhmi-origin-verify"
        }
      ],
      "memory": 1100,
      "memoryReservation": 900,
      "cpu": 256,
      "healthCheck": {
        "command": [
          "CMD",
          "/healthcheck",
          "http://localhost:8082/healthz"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/banhmi-mcp",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "laksa"
        }
      }
    }
  ]
}