# banhmi ECS image (ARM64 Graviton) — in-process ONNX Qwen3-Embedding.
#
# Same as Containerfile.cloudrun.onnx but targets aarch64 (Graviton t4g).
# Includes a static /healthcheck binary for ECS health checks (distroless
# has no shell or curl). Build natively on ARM64 (c7g spot or t4g).
#
# Build (on ARM64 host, from repo root):
#   podman build -t banhmi-ecs -f deploy/containerfiles/Containerfile.ecs.onnx .
#
# Build from S3 cache:
#   podman build -t banhmi-ecs \
#     --build-arg CACHE_BASE=https://banhmi-build-cache.s3.ap-southeast-1.amazonaws.com/deps \
#     -f deploy/containerfiles/Containerfile.ecs.onnx .

ARG ORT_VERSION=1.26.0
ARG TOKENIZERS_VERSION=v1.27.0
ARG CACHE_BASE=""

# ── Fetch assets ─────────────────────────────────────────────────────────────
FROM docker.io/debian:12-slim AS fetch
ARG ORT_VERSION
ARG CACHE_BASE
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /assets

RUN if [ -n "$CACHE_BASE" ]; then \
      curl -fsSL "${CACHE_BASE}/qwen3-embedding/model_fp16.onnx" -o model_fp16.onnx; \
      curl -fsSL "${CACHE_BASE}/qwen3-embedding/model_fp16.onnx_data" -o model_fp16.onnx_data; \
      curl -fsSL "${CACHE_BASE}/qwen3-embedding/tokenizer.json" -o tokenizer.json; \
    else \
      curl -fsSL "https://huggingface.co/onnx-community/Qwen3-Embedding-0.6B-ONNX/resolve/main/onnx/model_fp16.onnx" -o model_fp16.onnx; \
      curl -fsSL "https://huggingface.co/onnx-community/Qwen3-Embedding-0.6B-ONNX/resolve/main/onnx/model_fp16.onnx_data" -o model_fp16.onnx_data; \
      curl -fsSL "https://huggingface.co/onnx-community/Qwen3-Embedding-0.6B-ONNX/resolve/main/tokenizer.json" -o tokenizer.json; \
    fi

RUN if [ -n "$CACHE_BASE" ]; then \
      curl -fsSL "${CACHE_BASE}/ort/${ORT_VERSION}/onnxruntime-linux-aarch64.tgz" -o ort.tgz; \
    else \
      curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-aarch64-${ORT_VERSION}.tgz" -o ort.tgz; \
    fi \
 && tar xzf ort.tgz \
 && cp onnxruntime-linux-aarch64-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} /assets/libonnxruntime.so \
 && rm -rf onnxruntime-linux-aarch64-${ORT_VERSION} ort.tgz

# ── Go builder (CGO; -tags onnx) ──────────────────────────────────────────────
FROM docker.io/golang:1.26.3-bookworm AS build
ARG TOKENIZERS_VERSION
ARG CACHE_BASE
ENV CGO_ENABLED=1 GOFLAGS=-trimpath GOOS=linux GOARCH=arm64
RUN if [ -n "$CACHE_BASE" ]; then \
      curl -fsSL "${CACHE_BASE}/tokenizers/${TOKENIZERS_VERSION}/libtokenizers.linux-arm64.tar.gz" -o /tmp/lt.tgz; \
    else \
      curl -fsSL "https://github.com/daulet/tokenizers/releases/download/${TOKENIZERS_VERSION}/libtokenizers.linux-arm64.tar.gz" -o /tmp/lt.tgz; \
    fi \
 && tar xzf /tmp/lt.tgz -C /usr/lib && rm /tmp/lt.tgz
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_LDFLAGS="-L/usr/lib" go build -tags onnx -ldflags="-s -w" -o /out/server ./cmd/server
RUN CGO_LDFLAGS="-L/usr/lib" go build -tags onnx -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck

# ── Runtime: distroless/cc (glibc + libstdc++), non-root ──────────────────────
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build  /out/server                     /server
COPY --from=build  /out/healthcheck                /healthcheck
COPY --from=fetch  /assets/libonnxruntime.so       /usr/lib/libonnxruntime.so
COPY --from=fetch  /assets/model_fp16.onnx         /models/qwen3-embedding/model_fp16.onnx
COPY --from=fetch  /assets/model_fp16.onnx_data    /models/qwen3-embedding/model_fp16.onnx_data
COPY --from=fetch  /assets/tokenizer.json          /models/qwen3-embedding/tokenizer.json

ENV BANHMI_EMBED_QUERY=onnx \
    BANHMI_ONNX_MODEL=/models/qwen3-embedding/model_fp16.onnx \
    BANHMI_ONNX_TOKENIZER=/models/qwen3-embedding/tokenizer.json \
    BANHMI_ONNX_LIB=/usr/lib/libonnxruntime.so

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/server"]
