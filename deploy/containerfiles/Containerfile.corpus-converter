# Disposable child protocol only. No native converters or build-time downloads.
# Hosted packaging supplies a static Linux binary built with CGO_ENABLED=0 and
# -buildmode=exe from internal/corpus/conversion/sandbox/cmd/child.
# Build context: a hosted staging directory containing corpus-converter-child.
# ContainerLauncher passes a fixed OCI command template: read-only root/input,
# private scratch bind mount and /tmp bound to the same attempt temp directory, --network=none, user/PID
# namespaces, seccomp profile, --cap-drop=ALL, no-new-privileges, CPU/memory/PID
# cgroup limits and --init. The configured runtime must enforce these flags,
# own/reap the PID namespace and support inspect/kill/rm with cgroupfs. The
# operator must configure CgroupParent as an empty delegated cgroup v2 subtree
# separate from the supervisor process cgroup, with writable cgroup.subtree_control
# and enabled cpu/memory/pids controllers. The kernel must expose memory.peak.
# The supervisor creates corpus-attempt-* parents before launch, passes
# --cgroup-parent, and samples hierarchical CPU/peak memory after confirmed
# termination, before removing the container and then its parent. Construction
# fails closed without this delegation and counter support. The operator must
# supply a restrictive seccomp file and a hard quota for the private scratch bind.
# The supervisor bounds Wait and confirms teardown before validating outputs.
# Never mount credentials, database endpoints, host sockets or shared caches.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:26f9b99f2463f55f20db19feb4d96eb88b056e0f1be7016bb9296a464a89d772
COPY --chown=65532:65532 --chmod=0555 corpus-converter-child /corpus-converter-child
USER 65532:65532
WORKDIR /scratch
ENTRYPOINT ["/corpus-converter-child", "--sandbox-child"]
