# banhmi pipeline GPU image — unified for banhmi-writer (Job) and banhmi-embedder
# (HTTP service). Both modes run from `cmd/pipeline` with `-tags onnx`:
#
#   Writer:   /pipeline -config /config.yaml -run-all
#   Embedder: /pipeline -serve-embed :8080
#
# Build (from repo root):
#   podman build -t banhmi-pipeline-gpu -f deploy/containerfiles/Containerfile.pipeline-gpu .
#
# The image includes ONNX Runtime with CUDA EP for L4 GPU embedding, plus
# MuPDF/LibreOffice for extraction (writer mode). Set BANHMI_ONNX_CUDA=1 to
# enable GPU; without it the ONNX Runtime falls back to CPU.

ARG ORT_VERSION=1.27.0
ARG TOKENIZERS_VERSION=v1.27.0
ARG MODEL_REPO=gpahal/bge-m3-onnx-int8
ARG CUDA_TAG=12.9.0-base-ubuntu24.04

# ── Fetch assets: ONNX model + tokenizer + ONNX Runtime GPU shared lib ──────
FROM docker.io/debian:12-slim AS fetch
ARG ORT_VERSION
ARG MODEL_REPO
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /assets
RUN curl -fsSL "https://huggingface.co/${MODEL_REPO}/resolve/main/model_quantized.onnx" -o model_quantized.onnx \
 && curl -fsSL "https://huggingface.co/${MODEL_REPO}/resolve/main/tokenizer.json" -o tokenizer.json
RUN curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz" -o ort-gpu.tgz \
 && tar xzf ort-gpu.tgz \
 && cp onnxruntime-linux-x64-gpu-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION} /assets/libonnxruntime.so \
 && rm -rf onnxruntime-linux-x64-gpu-${ORT_VERSION} ort-gpu.tgz

# ── Go builder (CGO; -tags onnx) ────────────────────────────────────────────
FROM docker.io/golang:1.26.3-bookworm AS build
ARG TOKENIZERS_VERSION
ENV CGO_ENABLED=1 GOFLAGS=-trimpath GOOS=linux
RUN curl -fsSL "https://github.com/daulet/tokenizers/releases/download/${TOKENIZERS_VERSION}/libtokenizers.linux-amd64.tar.gz" \
      -o /tmp/lt.tgz && tar xzf /tmp/lt.tgz -C /usr/lib && rm /tmp/lt.tgz
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_LDFLAGS="-L/usr/lib" go build -tags onnx \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/pipeline ./cmd/pipeline
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/migrate ./cmd/migrate
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/seed ./cmd/seed

# ── Runtime: CUDA base + extraction deps ────────────────────────────────────
FROM docker.io/nvidia/cuda:${CUDA_TAG}
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        fonts-dejavu-core \
        fonts-liberation \
        libmupdf-dev \
        libreoffice-writer \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/banhmi

COPY --from=build  /out/pipeline /pipeline
COPY --from=build  /out/migrate  /migrate
COPY --from=build  /out/seed     /seed
COPY --from=fetch  /assets/libonnxruntime.so     /usr/lib/libonnxruntime.so
COPY --from=fetch  /assets/model_quantized.onnx  /models/bge-m3/model_quantized.onnx
COPY --from=fetch  /assets/tokenizer.json        /models/bge-m3/tokenizer.json

ENV BANHMI_ONNX_MODEL=/models/bge-m3/model_quantized.onnx \
    BANHMI_ONNX_TOKENIZER=/models/bge-m3/tokenizer.json \
    BANHMI_ONNX_LIB=/usr/lib/libonnxruntime.so \
    BANHMI_ONNX_CUDA=1 \
    HOME=/home/banhmi

RUN useradd --no-create-home --uid 1000 --user-group banhmi \
    && mkdir -p /home/banhmi /data \
    && chown -R banhmi:banhmi /home/banhmi /data /opt/banhmi

USER 1000:1000
