# banhmi MCP server image (ARM64 Graviton) — slim, CGO-free, no embedder.
#
# v0.4.0 read-path split: this image runs ONLY the MCP evidence server (cmd/server).
# Query embedding comes from the standalone embedder service via BANHMI_EMBED_ENDPOINT
# (+ BANHMI_EMBED_TOKEN), set in the ECS task definition. BANHMI_EMBED_QUERY is unset
# (no in-process embedder). No ONNX model, no ORT, no libtokenizers — fast deploys,
# sub-second restarts, ~30 MB image.
#
# ECS health check should probe /healthz via the healthcheck binary:
#   CMD ["/healthcheck", "http://localhost:8080/healthz"]
#
# Build (on ARM64 host, from repo root):
#   podman build -t banhmi-server -f deploy/containerfiles/Containerfile.ecs.server .
#
# VERSION build arg stamps corpus_status via -X main.version:
#   podman build -t banhmi-server --build-arg VERSION=0.4.0-20260719 \
#     -f deploy/containerfiles/Containerfile.ecs.server .

ARG GO_IMAGE=docker.io/golang:1.26.3-bookworm
# distroless/cc, NOT distroless/static: Go 1.26 emits PIE binaries on linux/arm64
# (dynamically linked, interpreter ld-linux-aarch64) even with CGO_ENABLED=0, and
# static-debian12 ships no dynamic loader — exec fails with "no such file or
# directory" (hit in prod 2026-07-19). cc ships the loader; same base as the
# proven onnx image.
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot
# VERSION lands in corpus_status via -X main.version (default keeps local builds honest).
ARG VERSION=dev

# ── Go builder (CGO ON, no onnx tag) ─────────────────────────────────────────
# CGO_ENABLED=1 is REQUIRED even though this image has no onnx embedder:
# go-fitz only statically links MuPDF in cgo mode; with CGO off it switches to
# purego dlopen of libmupdf.so at package init, which panics in distroless
# (hit in prod 2026-07-19, second incident of the day).
FROM ${GO_IMAGE} AS build
ARG VERSION
ENV CGO_ENABLED=1 GOFLAGS=-trimpath GOOS=linux GOARCH=arm64
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/server ./cmd/server
RUN go build -ldflags="-s -w" -o /out/healthcheck ./cmd/healthcheck

# ── Runtime: distroless/cc (glibc loader for the PIE binary), non-root ────────
FROM ${RUNTIME_IMAGE}
COPY --from=build /out/server      /server
COPY --from=build /out/healthcheck /healthcheck

EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/server"]
